# StaySetu Platform Environment Variables

# Next.js Site URL
NEXT_PUBLIC_SITE_URL=https://stat-setu-app.vercel.app

# Razorpay Payment Gateway (Optional for Live Mode, fallback test mode active by default)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Database (Prisma SQLite by default)
DATABASE_URL=file:./dev.db
